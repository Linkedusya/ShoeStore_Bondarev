<Window x:Class="ShoeStore_Bondarev.AddEditTovarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление/редактирование товара" Height="600" Width="700"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/icon.ico"
        FontFamily="Times New Roman"
        ResizeMode="NoResize">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#7FFF00" Padding="15">
            <TextBlock Text="Управление товаром" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Форма -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Фото -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Фото товара" VerticalAlignment="Center" Margin="0,10"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,10">
                    <Image Name="ImgTovar" Width="100" Height="80" Stretch="Uniform" 
                           Source="/Resources/picture.png" Margin="0,0,10,0"/>
                    <Button Name="BtnSelectImage" Content="Выбрать изображение" 
                            Click="BtnSelectImage_Click" Padding="10,5" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Артикул (только для чтения при редактировании) -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Артикул" VerticalAlignment="Center" Margin="0,10"/>
                <TextBox Name="TbArticle" Grid.Row="1" Grid.Column="1" Height="25" Margin="0,10" 
                         VerticalContentAlignment="Center"/>

                <!-- Наименование -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Наименование товара" VerticalAlignment="Center" Margin="0,10"/>
                <TextBox Name="TbName" Grid.Row="2" Grid.Column="1" Height="25" Margin="0,10" 
                         VerticalContentAlignment="Center"/>

                <!-- Категория -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Категория товара" VerticalAlignment="Center" Margin="0,10"/>
                <ComboBox Name="CmbCategory" Grid.Row="3" Grid.Column="1" Height="25" Margin="0,10"
                          DisplayMemberPath="Наименование_Категории" 
                          SelectedValuePath="Id_Категории"/>

                <!-- Описание -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Описание товара" VerticalAlignment="Top" Margin="0,10"/>
                <TextBox Name="TbDescription" Grid.Row="4" Grid.Column="1" Height="60" Margin="0,10" 
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                <!-- Производитель -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Производитель товара" VerticalAlignment="Center" Margin="0,10"/>
                <ComboBox Name="CmbManufacturer" Grid.Row="5" Grid.Column="1" Height="25" Margin="0,10"
                          DisplayMemberPath="Наименование_Производителя" 
                          SelectedValuePath="Id_Производителя"/>

                <!-- Поставщик -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Поставщик товара" VerticalAlignment="Center" Margin="0,10"/>
                <ComboBox Name="CmbSupplier" Grid.Row="6" Grid.Column="1" Height="25" Margin="0,10"
                          DisplayMemberPath="Наименование_Поставщика" 
                          SelectedValuePath="Id_Поставщика"/>

                <!-- Цена -->
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Цена товара" VerticalAlignment="Center" Margin="0,10"/>
                <TextBox Name="TbPrice" Grid.Row="7" Grid.Column="1" Height="25" Margin="0,10" 
                         VerticalContentAlignment="Center"/>

                <!-- Единица измерения -->
                <TextBlock Grid.Row="8" Grid.Column="0" Text="Единица измерения товара" VerticalAlignment="Center" Margin="0,10"/>
                <TextBox Name="TbUnit" Grid.Row="8" Grid.Column="1" Height="25" Margin="0,10" 
                         VerticalContentAlignment="Center"/>

                <!-- Количество -->
                <TextBlock Grid.Row="9" Grid.Column="0" Text="Количество товара на складе" VerticalAlignment="Center" Margin="0,10"/>
                <TextBox Name="TbQuantity" Grid.Row="9" Grid.Column="1" Height="25" Margin="0,10" 
                         VerticalContentAlignment="Center"/>

                <!-- Скидка -->
                <TextBlock Grid.Row="10" Grid.Column="0" Text="Действующая скидка" VerticalAlignment="Center" Margin="0,10"/>
                <TextBox Name="TbDiscount" Grid.Row="10" Grid.Column="1" Height="25" Margin="0,10" 
                         VerticalContentAlignment="Center"/>

                <!-- Кнопка Сохранить -->
                <Button Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" 
                        Content="Сохранить данные" Click="BtnSave_Click" 
                        Padding="20,10" Margin="0,20" HorizontalAlignment="Center"
                        Background="#7FFF00" FontWeight="Bold" FontSize="14"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>