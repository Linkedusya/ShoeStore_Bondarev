<Window x:Class="ShoeStore_Bondarev.MainMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО Обувь - Список товаров" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/icon.ico"
        FontFamily="Times New Roman">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#7FFF00" Padding="15">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Image Source="/Resources/logo.png" Width="45" Height="45" Margin="0,0,15,0"/>
                    <TextBlock Text="Список товаров" FontSize="24" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Name="TbUserRole" Text="" FontWeight="Bold" FontSize="14" 
                               VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button x:Name="BtnOrders" Content="Заказы" Click="BtnOrders_Click" 
                            Padding="10,5" Margin="0,0,5,0"/>
                    <Button Content="Выйти" Click="BtnLogout_Click" Padding="10,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ПАНЕЛЬ ФИЛЬТРОВ -->
        <Border x:Name="FilterPanel" Grid.Row="1" Background="#99FF33" Padding="10" Margin="10,5,10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Name="TxtSearch" Grid.Column="1" Height="25" VerticalContentAlignment="Center" 
                         TextChanged="TxtSearch_TextChanged"/>

                <TextBlock Text="Сортировка (по кол-ву):" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Name="SortAsc" Content="По возрастанию" Checked="Sort_Checked" Margin="0,0,5,0"/>
                    <RadioButton Name="SortDesc" Content="По убыванию" Checked="Sort_Checked"/>
                </StackPanel>

                <TextBlock Text="Поставщик:" Grid.Column="4" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <ComboBox Name="CmbManufacturer" Grid.Column="5" Height="25" 
                          SelectionChanged="CmbManufacturer_SelectionChanged"/>
            </Grid>
        </Border>

        <!-- ПАНЕЛЬ АДМИНИСТРАТОРА -->
        <Border x:Name="AdminPanel" Grid.Row="2" Background="#CCFF99" Padding="10" Margin="10,0,10,5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Добавить товар" Click="BtnAddTovar_Click" 
                        Padding="15,8" Margin="5" FontWeight="Bold" Background="#7FFF00"/>
                <Button Content="Удалить товар" Click="BtnDeleteTovar_Click" 
                        Padding="15,8" Margin="5" FontWeight="Bold" Background="#FF7F7F"/>
            </StackPanel>
        </Border>

        <!-- Список товаров -->
        <ListView Name="ListTovar" Grid.Row="3" Margin="10" 
                  MouseDoubleClick="ListTovar_MouseDoubleClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding is_discount}" Value="True">
                            <Setter Property="Background" Value="#2E8B57"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding is_quantity}" Value="True">
                            <Setter Property="Background" Value="Cyan"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="2" Margin="5" BorderBrush="Black" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderThickness="1" BorderBrush="Black" Margin="5">
                                <Image Source="{Binding Фото}" Margin="5" Width="120" Height="120" Stretch="Uniform">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Фото}" Value="{x:Null}">
                                                    <Setter Property="Source" Value="/Resources/picture.png"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Фото}" Value="">
                                                    <Setter Property="Source" Value="/Resources/picture.png"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Border>

                            <Border Grid.Column="1" BorderThickness="1" BorderBrush="Black" Margin="5">
                                <StackPanel Margin="8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Наименование_Категории}" FontWeight="Bold"/>
                                        <TextBlock Text=" | " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Наименование_Товара}" FontWeight="Bold"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="Описание товара: " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Описание_Товара}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Производитель: " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Наименование_Производителя}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Поставщик: " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Наименование_Поставщика}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="Цена: " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Цена, StringFormat={}{0:F2} руб.}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding is_on_sale}" Value="True">
                                                            <Setter Property="Foreground" Value="Red"/>
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="8,0,0,0" FontWeight="Bold"
                                                   Text="{Binding price_discount, StringFormat=Новая цена: {0:F2} руб.}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding is_on_sale}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Единица измерения: " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Единица_Измерения}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Количество на складе: " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Кол_во_На_Складе}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" BorderThickness="1" BorderBrush="Black" Margin="5">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Действующая скидка" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Действующая_Скидка, StringFormat={}{0}%}" 
                                               FontSize="22" FontWeight="Bold" TextAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>