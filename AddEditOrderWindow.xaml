<Window x:Class="ShoeStore_Bondarev.AddEditOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление/редактирование заказа" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/icon.ico"
        FontFamily="Times New Roman"
        ResizeMode="NoResize">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#7FFF00" Padding="15">
            <TextBlock Text="Управление заказом" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Форма -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Артикул -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Артикул заказа" VerticalAlignment="Center" Margin="0,10"/>
                <TextBox Name="TbArticle" Grid.Row="0" Grid.Column="1" Height="25" Margin="0,10" 
                         VerticalContentAlignment="Center" IsReadOnly="True"/>

                <!-- Статус -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Статус заказа" VerticalAlignment="Center" Margin="0,10"/>
                <ComboBox Name="CmbStatus" Grid.Row="1" Grid.Column="1" Height="25" Margin="0,10"
                          DisplayMemberPath="Наименование_Статуса" 
                          SelectedValuePath="IdStatus"/>

                <!-- Пункт выдачи -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Адрес пункта выдачи" VerticalAlignment="Center" Margin="0,10"/>
                <ComboBox Name="CmbPickupPoint" Grid.Row="2" Grid.Column="1" Height="25" Margin="0,10"
                          DisplayMemberPath="Адрес" 
                          SelectedValuePath="Id_Пункта"/>

                <!-- Дата заказа -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Дата заказа" VerticalAlignment="Center" Margin="0,10"/>
                <DatePicker Name="DpOrderDate" Grid.Row="3" Grid.Column="1" Height="25" Margin="0,10"/>

                <!-- Дата выдачи -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Дата выдачи" VerticalAlignment="Center" Margin="0,10"/>
                <DatePicker Name="DpDeliveryDate" Grid.Row="4" Grid.Column="1" Height="25" Margin="0,10"/>

                <!-- Кнопка Сохранить -->
                <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" 
                        Content="Сохранить данные" Click="BtnSave_Click" 
                        Padding="20,10" Margin="0,20" HorizontalAlignment="Center"
                        Background="#7FFF00" FontWeight="Bold" FontSize="14"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>