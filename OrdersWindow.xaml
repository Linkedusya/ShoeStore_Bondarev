<Window x:Class="ShoeStore_Bondarev.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО Обувь - Список заказов" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/icon.ico"
        FontFamily="Times New Roman">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#7FFF00" Padding="15">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Image Source="/Resources/logo.png" Width="45" Height="45" Margin="0,0,15,0"/>
                    <TextBlock Text="Список заказов" FontSize="24" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Name="TbUserRole" Text="" FontWeight="Bold" FontSize="14" 
                               VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Назад" Click="BtnBack_Click" Padding="10,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ПАНЕЛЬ АДМИНИСТРАТОРА -->
        <Border x:Name="AdminPanel" Grid.Row="1" Background="#CCFF99" Padding="10" Margin="10,5,10,5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Добавить заказ" Click="BtnAddOrder_Click" 
                        Padding="15,8" Margin="5" FontWeight="Bold" Background="#7FFF00"/>
                <Button Content="Удалить заказ" Click="BtnDeleteOrder_Click" 
                        Padding="15,8" Margin="5" FontWeight="Bold" Background="#FF7F7F"/>
            </StackPanel>
        </Border>

        <!-- Список заказов -->
        <ListView Name="ListOrders" Grid.Row="2" Margin="10" 
                  MouseDoubleClick="ListOrders_MouseDoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="2" Margin="5" BorderBrush="Black" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="10">
                                <TextBlock Text="{Binding Артикул_Заказа, StringFormat='Артикул заказа: {0}'}" 
                                           FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding Статус_Заказа, StringFormat='Статус заказа: {0}'}" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding Адрес_Пункта_Выдачи, StringFormat='Адрес пункта выдачи: {0}'}" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding Дата_Заказа, StringFormat='Дата заказа: {0:dd.MM.yyyy}'}" Margin="0,5,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1" BorderThickness="1" BorderBrush="Black" Margin="5">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Дата доставки" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Дата_Доставки, StringFormat={}{0:dd.MM.yyyy}}" 
                                               FontSize="18" FontWeight="Bold" TextAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>